{
  "entities": {
    "app_data": {
      "title": "AppData",
      "description": "Shared real-time application state across all users",
      "type": "object",
      "properties": {
        "customers": {
          "type": "array",
          "description": "List of customer order records"
        },
        "bulkItems": {
          "type": "array",
          "description": "List of bulk OCR processed items"
        },
        "msgTemplateCod": {
          "type": "string",
          "description": "COD WhatsApp template"
        },
        "msgTemplateNoCod": {
          "type": "string",
          "description": "No-COD WhatsApp template"
        },
        "msgTemplateTitip": {
          "type": "string",
          "description": "Titip COD WhatsApp template"
        },
        "msgTemplateOh": {
          "type": "string",
          "description": "On-Hold (OH) Sending camera WhatsApp template"
        },
        "msgTemplateReturn": {
          "type": "string",
          "description": "Return Sending camera WhatsApp template"
        },
        "tempatCodList": {
          "type": "array",
          "description": "List of drop off location settings"
        },
        "waReportNumber": {
          "type": "string",
          "description": "Target WhatsApp Business number for Sending camera photo, name, and address"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last modification"
        }
      },
      "required": ["customers", "updatedAt"]
    },
    "wa_chat_index_shard": {
      "title": "WaChatIndexShard",
      "description": "Compressed monotonic backup of WhatsApp chat index and locked history anchors",
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "Encoding format identifier (gzip-json-v1)"
        },
        "payloadGzipB64": {
          "type": "string",
          "description": "Base64-encoded gzip-compressed JSON index payload",
          "maxLength": 950000
        },
        "counts": {
          "type": "object",
          "description": "Summary counts for monotonic integrity verification"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last cloud index sync"
        }
      },
      "required": ["format", "payloadGzipB64", "updatedAt"]
    }
  },
  "firestore": {
    "/app_data/{document}": {
      "schema": {
        "$ref": "#/entities/app_data"
      },
      "description": "Global shared application documents including global state, archived customers, and WhatsApp chat index shards"
    }
  }
}
